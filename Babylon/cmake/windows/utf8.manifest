<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  SPDX-License-Identifier: MPL-2.0
  This Source Code Form is subject to the terms of the Mozilla Public
  License, v. 2.0. If a copy of the MPL was not distributed with this
  file, You can obtain one at https://mozilla.org/MPL/2.0/.

  Babylon's copy of the UTF-8 application manifest, so the engine's test programs get it when
  Babylon builds on its own. activeCodePage UTF-8 makes the process use UTF-8 as its ANSI code
  page (Windows 10 1903+), so the UCRT's char* file APIs read the UTF-8 paths Babylon's file
  system and the host hand them.

  The compatibility entry declares Windows 10, which the UTF-8 code page requires. DPI awareness
  is left to SDL.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="Babylon" version="1.0.0.0" processorArchitecture="*"/>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
